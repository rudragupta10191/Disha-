# Non-secret local configuration for Disha Phase 1.
# Copy to .env only if your shell workflow needs it; never commit .env.
DISHA_NAME=Disha
DISHA_OWNER=Rudra
DISHA_MASTER=Neo/Hermes
DISHA_PRIMARY_AI=Cactus Needle 2
DISHA_LOG_LEVEL=INFO
DISHA_AI_PROVIDER=cactus_needle2
# Set these only when a real Needle 2 runtime and model are installed locally.
DISHA_NEEDLE2_RUNTIME=cactus_needle2
# DISHA_NEEDLE2_MODEL=/path/to/real/needle2/model
# Cloud providers remain disabled unless all three values are explicitly set.
# DISHA_CLOUD_PROVIDER=
# DISHA_CLOUD_BASE_URL=
# DISHA_CLOUD_API_KEY=
# Configure a private gateway token explicitly; never commit the real value.
# DISHA_GATEWAY_TOKEN=
